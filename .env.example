# DienteLink — Environment Variables
# Copy this file to .env and fill in your values

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Correo de contacto en copy de cobros (NO autoriza admin; eso es RPC is_platform_admin)
VITE_ADMIN_CONTACT_EMAIL=admin@tudominio.com

# Guardado atómico de pacientes (save_patient RPC). Default off.
# Solo 'true' en staging/desechable DESPUÉS de aplicar migraciones + smoke.
# Nunca en prod hasta cutover validado.
# VITE_USE_SAVE_PATIENT_RPC=true
