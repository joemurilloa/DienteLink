# DienteLink — Environment Variables
# Copy this file to .env and fill in your values

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Pagadito (Honduras payment gateway) ───────────────────────────────────────
# Development: Use sandbox credentials from https://sandbox.pagadito.com
# Production: Store ONLY in Supabase Edge Function Secrets (Dashboard > Settings > Secrets)
#             NEVER commit production credentials here.
# ⚠️  PAGADITO_UID and PAGADITO_WSK are only needed for local Edge Function testing.
#     They are NOT read by the frontend — only by supabase/functions/pagadito-checkout/index.ts
PAGADITO_UID=your_sandbox_uid_here
PAGADITO_WSK=your_sandbox_wsk_here
